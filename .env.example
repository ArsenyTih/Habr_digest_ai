# Ключ API модели
OPENAI_API_KEY=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
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Эмбеддинги для RAG (у Groq нет эмбеддингов, поэтому для RAG нужен отдельный ключ OpenAI)
# Если оставить пустым, бот будет работать в обычном режиме без истории RAG
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Токен бота из @BotFather и ваш числовой ID из @userinfobot
TELEGRAM_BOT_TOKEN=8898347790:AAEsX0hqwfLq5v0V_ujg7P2qkNVprzUyWTA
TELEGRAM_USER_ID=211906776

# Источник статей
HABR_RSS_URL=https://habr.com/ru/rss/articles/

# Расписание отправки (по умолчанию 9:00 и 18:00 по Москве)
TIMEZONE=Europe/Moscow
DIGEST_HOUR_1=9
DIGEST_HOUR_2=18

# Пути к базам данных
SQLITE_PATH=data/digest.db
CHROMA_PATH=data/chroma

# MCP-клиент для загрузки статей
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m mcp_server_fetch
MCP_IGNORE_ROBOTS=false
FETCH_MAX_LENGTH=20000
MCP_TIMEOUT_SECONDS=60

# Лимиты для модели (подогнаны под лимиты Groq: 30 RPM, 8K TPM, 1K/день)
ARTICLE_MAX_CHARS_FOR_LLM=2500
MIN_SCORE=6
MAX_NEW_ARTICLES=5
MAX_DIGEST_ITEMS=3
LLM_CONCURRENCY=1

# Интересы по умолчанию (через запятую)
DEFAULT_TOPICS=Python, ИИ-агенты, LLM

# Отправлять ли пустое сообщение по расписанию, если интересных статей не нашлось
SEND_EMPTY_NOTICE=false

# Тестовый режим (граф выполняется, но ничего не записывается в базу данных)
DRY_RUN=false
